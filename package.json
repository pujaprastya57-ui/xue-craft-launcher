{
  "name": "traecraft-launcher",
  "productName": "xue Craft launcher",
  "version": "1.5.2",
  "description": "第三方非官方 Minecraft 启动器：微软账号登录、原版全版本下载、版本隔离、Modrinth 资源与整合包、Fabric/Forge/NeoForge 支持",
  "author": "xue Craft launcher",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "node scripts/selftest.js",
    "smoke": "electron . --smoke-test",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.traecraft.launcher",
    "productName": "xue Craft launcher",
    "copyright": "Copyright © 2026 xue Craft launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "xue Craft launcher",
      "artifactName": "xueCraft-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "xueCraft-${version}-portable.${ext}"
    }
  }
}
